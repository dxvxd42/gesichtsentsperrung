#!/usr/bin/env python3
"""Notlösung für den Sperrbildschirm: drückt einmal kurz eine (unsichtbare) Shift-Taste
über ein virtuelles Eingabegerät. Das wirkt wie ein echter Tastendruck: Der Sperrbildschirm
blendet sich ein und startet Gesichts- und Fingerabdruckerkennung.
Wird nach dem Aufwachen aufgerufen, wenn sich die KDE-Datei nicht mehr anpassen ließ.
Keine Abhängigkeiten außer Python; braucht Schreibrecht auf /dev/uinput (root)."""
import fcntl, os, struct, sys, time

UI_SET_EVBIT, UI_SET_KEYBIT = 0x40045564, 0x40045565
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502
EV_SYN, EV_KEY, SYN_REPORT, KEY_LEFTSHIFT = 0, 1, 0, 42
BUS_VIRTUAL = 0x06


def ev(fd, typ, code, val):
    t = time.time()
    os.write(fd, struct.pack("llHHi", int(t), int((t % 1) * 1e6), typ, code, val))


def main():
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    try:
        fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(fd, UI_SET_KEYBIT, KEY_LEFTSHIFT)
        name = b"sperrbild-sofort".ljust(80, b"\0")
        # struct uinput_user_dev: name[80], input_id (4x u16), ff_effects_max, abs-Tabellen
        os.write(fd, name + struct.pack("HHHHi", BUS_VIRTUAL, 0x1, 0x1, 1, 0) + b"\0" * (4 * 64 * 4))
        fcntl.ioctl(fd, UI_DEV_CREATE)
        time.sleep(0.8)  # KWin muss das neue Gerät erst erkennen
        ev(fd, EV_KEY, KEY_LEFTSHIFT, 1); ev(fd, EV_SYN, SYN_REPORT, 0)
        time.sleep(0.05)
        ev(fd, EV_KEY, KEY_LEFTSHIFT, 0); ev(fd, EV_SYN, SYN_REPORT, 0)
        time.sleep(0.3)
        fcntl.ioctl(fd, UI_DEV_DESTROY)
    finally:
        os.close(fd)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--warten":
        time.sleep(float(sys.argv[2]) if len(sys.argv) > 2 else 2)
    main()
